# Copy to .env for local dev. Never commit .env.

# Supabase PostgreSQL connection string
# Found in: Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Auth
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Anthropic Claude API
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (ChatGPT) API - optional. Without this, humor generation falls back
# to whichever providers below DO have a key set.
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq API - free tier, no billing required.
# Get from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Moonshot (Kimi) API - optional, OpenAI-compatible format.
# Get from: https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=
MOONSHOT_MODEL=moonshot-v1-8k
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1/chat/completions

# Google Gemini API - optional.
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Imgflip API - used for the optional meme sticker feature (overlays a
# Claude-written caption onto a real meme template). Free account required.
# Sign up: https://imgflip.com/signup
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# Email exempted from the daily check-in limit, for testing.
TEST_ADMIN_EMAIL=vsara5444@gmail.com

# CORS - set to your Vercel frontend URL in production
CORS_ORIGIN=http://localhost:5173

# Used to build the password-reset link emailed to users - set to your
# deployed frontend URL in production (e.g. https://relol-frontend.vercel.app)
FRONTEND_URL=http://localhost:5173

# Resend (https://resend.com) - used to send password-reset emails.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=MoodBooster <onboarding@resend.dev>

# Joke dedupe threshold (0-1). Higher = stricter.
JOKE_SIMILARITY_THRESHOLD=0.55

# Daily check-in limit per user (test admin above is always exempt).
DAILY_ENTRY_LIMIT=3
