# Copy to .env for local dev. Never commit .env.

# Supabase PostgreSQL connection string
# Found in: Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Auth
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Anthropic Claude API
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-4-6

# CORS - set to your Vercel frontend URL in production
CORS_ORIGIN=http://localhost:5173

# Joke dedupe threshold (0-1). Higher = stricter.
JOKE_SIMILARITY_THRESHOLD=0.55
