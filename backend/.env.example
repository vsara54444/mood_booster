# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# --- MSSQL ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ReLOL
DB_USER=sa
DB_PASSWORD=replace_with_your_password
DB_ENCRYPT=true
DB_TRUST_CERT=true

# --- Anthropic Claude API ---
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-4-6

# Joke similarity rejection threshold (0-1). Higher = stricter dedupe.
JOKE_SIMILARITY_THRESHOLD=0.55
